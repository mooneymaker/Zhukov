# Скопіюйте цей файл у .env.local і заповніть. Файл .env.local у git не потрапляє.
# На Vercel ті самі змінні задаються в Project Settings → Environment Variables.

# Бот, який надсилає заявки з анкети. Токен видає @BotFather.
TELEGRAM_BOT_TOKEN=
# Чат, куди бот пише заявки (число, для груп починається з мінуса).
TELEGRAM_CHAT_ID=

# Якщо true, заявка не йде в Telegram, а друкується в лог сервера. Для розробки.
LEAD_DRY_RUN=true

# Адреса сайту без слеша в кінці. Потрібна для посилань у метаданих.
SITE_URL=http://localhost:3000

# true дозволяє пошуковикам індексувати сайт. Вмикати тільки на бойовому домені.
ALLOW_INDEXING=false
